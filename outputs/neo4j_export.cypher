MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_13.9'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_13.9", number: "13.9", title: "Clause 13.9", contract_id: "CONT_commercial_contract", category: "General", text: "The captions to the several Articles, Sections and subsections hereof are not a part of this Agreement, but\nare merely for convenience to assist in locating and reading the several Articles and Sectio", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_13.10'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_13.10", number: "13.10", title: "Clause 13.10", contract_id: "CONT_commercial_contract", category: "General", text: "It is expressly agreed that Valeant and Dova shall be independent contractors and that\nthe relationship between the two Parties shall not constitute a partnership, joint venture or agency. Neither Val", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_13.11'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_13.11", number: "13.11", title: "Clause 13.11", contract_id: "CONT_commercial_contract", category: "General", text: "Except as set forth in ARTICLE 11, no Person other than Dova or Valeant (and their\nrespective Affiliates and permitted successors and assignees hereunder) shall be deemed an intended beneficiary hereu", label: "Clause"};

MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.22'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.22", number: "6.22", title: "Clause 6.22", contract_id: "CONT_commercial_contract", category: "General", text: "If you request, and we can reasonably accommodate such request, we will furnish non-routine guidance and\nassistance to deal with your unusual or unique operating problems at reasonable per diem fees a", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.23'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.23", number: "6.23", title: "Clause 6.23", contract_id: "CONT_commercial_contract", category: "General", text: "At all times, you must maintain credit-card relationships with the credit- and debit-card\nissuers or sponsors, check or credit verification services, financial-center services, and electronic-fund-tra", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.24'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.24", number: "6.24", title: "Clause 6.24", contract_id: "CONT_commercial_contract", category: "General", text: "We may conduct annual conferences or conventions, which may include training sessions. We may require your\nOperating Principal, Certified Managers, and other designated employees to attend the confere", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.25'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.25", number: "6.25", title: "Clause 6.25", contract_id: "CONT_commercial_contract", category: "General", text: "We may, from time to time, but only to the extent permitted by law, establish and impose maximum and minimum prices for the\ngoods and services that you are permitted to sell or offer to sell. If we do", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.26'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.26", number: "6.26", title: "Clause 6.26", contract_id: "CONT_commercial_contract", category: "General", text: "After we perform our preopening obligations under this Agreement, we may request that you execute a\ncertification (the \u201cCertification of Performance\u201d), in a form we reasonably request, confirming such", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_7.4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_7.4", number: "7.4", title: "Clause 7.4", contract_id: "CONT_commercial_contract", category: "General", text: "We have the right, upon reasonable notice, to change, discontinue, or substitute for any of the\nProprietary Marks and to adopt new Proprietary Marks for use with the System without any liability for a", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_7.5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_7.5", number: "7.5", title: "Clause 7.5", contract_id: "CONT_commercial_contract", category: "General", text: "Party Challenges. The parties agree as follows:\n7.5.1 You agree to promptly notify us if you learn of any suspected infringement of the Proprietary Marks, any challenge to the\nvalidity of the Propriet", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10.7'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10.7", number: "10.7", title: "Clause 10.7", contract_id: "CONT_commercial_contract", category: "General", text: "If we require, you agree to participate in a gift card program that we specify. For this purpose, you must purchase the\nsoftware, hardware, and other items needed to sell and process gift cards, as we", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10.8'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10.8", number: "10.8", title: "Clause 10.8", contract_id: "CONT_commercial_contract", category: "General", text: "You agree not to use or permit the use or display of the Proprietary Marks as part of any Internet\ndomain name or website, or any other electronic identifier (including but not limited to e-mail addre", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10.9'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10.9", number: "10.9", title: "Clause 10.9", contract_id: "CONT_commercial_contract", category: "General", text: "You must use, and only use, the email address and other identifiers we designate in\nconnection with the business of the Franchised Business. You agree not to transmit or cause any other party to trans", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10.10'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10.10", number: "10.10", title: "Clause 10.10", contract_id: "CONT_commercial_contract", category: "General", text: "Because changes to technology are dynamic and not predictable within the term of this Agreement, and in\norder to provide for inevitable but unpredictable changes to technological needs and opportuniti", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10.11'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10.11", number: "10.11", title: "Clause 10.11", contract_id: "CONT_commercial_contract", category: "General", text: "You agree that exchanging information with us by e-mail and fax is an important way to enable\nquick, effective, and efficient communication, and that we are entitled to rely upon each other\u2019s use of e", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_14.8'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_14.8", number: "14.8", title: "Clause 14.8", contract_id: "CONT_commercial_contract", category: "General", text: "We have the right, exercisable within thirty (30) days after receipt of the notice specified in Section 14.2\n[No Transfer without Our Prior Written Consent], to send written notice to you that we inte", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_15.2'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_15.2", number: "15.2", title: "Clause 15.2", contract_id: "CONT_commercial_contract", category: "General", text: "We may terminate this Agreement by written notice to you, without giving you an\nopportunity to cure, upon the occurrence of any of the following events:\n15.2.1. You, the Operating Principal, and/or yo", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_16.3'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_16.3", number: "16.3", title: "Clause 16.3", contract_id: "CONT_commercial_contract", category: "General", text: "In order to preserve the goodwill of the System following termination, we (or our\ndesignee) have the right to enter the Premises (without liability to you, your Owners, or otherwise) for the purpose c", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_17.2'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_17.2", number: "17.2", title: "Clause 17.2", contract_id: "CONT_commercial_contract", category: "General", text: "For two (2) years after the expiration or termination of this Agreement or an approved\nTransfer to a new franchisee, you may not directly or indirectly own, manage, engage in, be employed by, advise, ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_17.3'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_17.3", number: "17.3", title: "Clause 17.3", contract_id: "CONT_commercial_contract", category: "General", text: "The Owners agree that they will personally bind themselves to this Section 17 by signing this Agreement or\nthe attached Guaranty. With respect to the Owners, the time period in Section 17.2 [After Ter", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_17.4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_17.4", number: "17.4", title: "Clause 17.4", contract_id: "CONT_commercial_contract", category: "General", text: "You may not attempt to circumvent the restrictions in Sections 17.1 [During Term] and 17.2 [After\nTermination, Expiration, or Transfer] by engaging in prohibited activity indirectly through any other ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_17.5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_17.5", number: "17.5", title: "Clause 17.5", contract_id: "CONT_commercial_contract", category: "General", text: "You agree that the existence of any claim you may have against us, whether or not arising from this Agreement, will\nnot constitute a defense to our enforcement of this Section 17. You agree to pay all", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_23.5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_23.5", number: "23.5", title: "Clause 23.5", contract_id: "CONT_commercial_contract", category: "General", text: "Except as otherwise stated in this Agreement, nothing in this Agreement is intended (nor shall be deemed) to\nconfer upon any party any rights or remedies under or by reason of this Agreement, except f", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.2'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.2", number: "25.2", title: "Clause 25.2", contract_id: "CONT_commercial_contract", category: "General", text: "You and the Owners must file any suit against us, and we may file any suit against you, in the federal or state\ncourt where our principal office is located at the time the suit is filed. The parties w", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.3'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.3", number: "25.3", title: "Clause 25.3", contract_id: "CONT_commercial_contract", category: "General", text: "Any lawsuit, claim, counterclaim, or other action may be conducted only on an individual basis,\nand not as part of a consolidated, common, or class action.", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.4", number: "25.4", title: "Clause 25.4", contract_id: "CONT_commercial_contract", category: "General", text: "You and we each irrevocably waive trial by jury in any litigation.", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.5", number: "25.5", title: "Clause 25.5", contract_id: "CONT_commercial_contract", category: "General", text: "Each of us waives any right to or claim of punitive, exemplary, multiple, or consequential\ndamages against the other in litigation and agrees to be limited to the recovery of actual damages sustained.", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.6'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.6", number: "25.6", title: "Clause 25.6", contract_id: "CONT_commercial_contract", category: "General", text: "Any and all claims and actions arising out of or relating to this Agreement, the relationship between\nyou and us, or your operation of the Restaurant, brought by any party hereto against the other, mu", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.7'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.7", number: "25.7", title: "Clause 25.7", contract_id: "CONT_commercial_contract", category: "General", text: "Except as provided in Sections 25.1 [Submission to Mediation] through 25.4 [Mutual Waiver of Jury\nTrial] above, no right or remedy that the parties have under this Agreement is exclusive of any other ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.8'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.8", number: "25.8", title: "Clause 25.8", contract_id: "CONT_commercial_contract", category: "General", text: "Nothing in this Agreement bars our right to obtain injunctive or declaratory relief against a breach or\nthreatened breach of this Agreement that will cause us loss or damage. You agree that we will no", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25.9'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25.9", number: "25.9", title: "Clause 25.9", contract_id: "CONT_commercial_contract", category: "General", text: "You agree to reimburse us for all expenses we reasonably incur (including attorneys\u2019 fees): (a) to enforce\nthe terms of this Agreement or any obligation owed to us by you and/or the Owners\u037e and (b) in", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_26.2'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_26.2", number: "26.2", title: "Clause 26.2", contract_id: "CONT_commercial_contract", category: "General", text: "You acknowledge that you received a copy of this Agreement, the exhibit(s) hereto, and agreements relating\nhereto, if any, with all of the blank lines therein filled in, at least seven (7) days before", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_26.3'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_26.3", number: "26.3", title: "Clause 26.3", contract_id: "CONT_commercial_contract", category: "General", text: "The Owners acknowledge that, by signing this Agreement or the Personal Guaranty attached as\nAppendix B, they are binding themselves as individuals to all of the terms and conditions of this Agreement,", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_26.4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_26.4", number: "26.4", title: "Clause 26.4", contract_id: "CONT_commercial_contract", category: "General", text: "Although we retain the right to establish and periodically modify System standards, which you have agreed to\nmaintain in the operation of the Franchised Business, you retain the right and sole respons", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_26.5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_26.5", number: "26.5", title: "Clause 26.5", contract_id: "CONT_commercial_contract", category: "General", text: "You acknowledge and agree that we may modify the offer of our franchises to other franchisees in any manner and at\nany time, which offers and agreements have or may have terms, conditions, and obligat", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_26.6'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_26.6", number: "26.6", title: "Clause 26.6", contract_id: "CONT_commercial_contract", category: "General", text: "Each party represents and warrants to the others that there are no other agreements, court orders, or any\nother legal obligations that would preclude or in any manner restrict such party from: (a) neg", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_1221'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_1221", number: "1221", title: "Clause 1221", contract_id: "CONT_commercial_contract", category: "General", text: "New York, New York 10020\nFacsimile:\n(212) 849-5914\nE-mail:\nrwheeler@mayerbrown.com\nAttention:\nReb D. Wheeler", label: "Clause"};


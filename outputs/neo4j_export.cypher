MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.18'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.18", number: "6.18", title: "Clause 6.18", contract_id: "CONT_commercial_contract", category: "General", text: "Year Refurbishment and Renovations. At our request, but not more often than once every five (5) years (and not before the fifth\nyear after you begin operating), unless sooner required by your lease, y", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6.19'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6.19", number: "6.19", title: "Clause 6.19", contract_id: "CONT_commercial_contract", category: "General", text: "6.19.1. Types and Amounts of Coverage. Throughout the entire Term, you must maintain such types of insurance, in such\namounts, as we may require. Such insurance is in addition to any other insurance t", label: "Clause"};

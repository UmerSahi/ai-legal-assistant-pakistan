MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_13.17'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_13.17", number: "13.17", title: "Clause 13.17", contract_id: "CONT_commercial_contract", category: "General", text: "Any reference in this Agreement to an Article, Section, subsection, paragraph, clause, or\nExhibit shall be deemed to be a reference to an Article, Section, subsection, paragraph, clause, or Exhibit, o", label: "Clause"};

MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_1'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_1", number: "1", title: "Clause 1", contract_id: "CONT_commercial_contract", category: "General", text: "Member shall not, during the term of the Franchise Agreement or thereafter, communicate, divulge or use, for\nany purpose other than the operation of the Franchised Business, any confidential informati", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_2'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_2", number: "2", title: "Clause 2", contract_id: "CONT_commercial_contract", category: "General", text: "All notices, requests, consents, claims, demands, waivers and other communications hereunder shall be in writing and shall be\ndeemed to have been given: (a) when delivered by hand (with written confir", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_3'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_3", number: "3", title: "Clause 3", contract_id: "CONT_commercial_contract", category: "General", text: "This Agreement shall be binding upon and inure to the benefit of the parties and their respective successors\nand permitted assigns\u037e provided that this Agreement shall not be assignable or otherwise tr", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_4", number: "4", title: "Clause 4", contract_id: "CONT_commercial_contract", category: "General", text: "(a) THIS AGREEMENT SHALL BE GOVERNED BY AND CONSTRUED IN ACCORDANCE WITH THE INTERNAL LAWS OF\nTHE COMMONWEALTH OF PENNSYLVANIA WITHOUT GIVING EFFECT TO ANY CHOICE OR CONFLICT OF LAW PROVISION OR RULE\n", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_5'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_5", number: "5", title: "Clause 5", contract_id: "CONT_commercial_contract", category: "General", text: "No delay or failure by the Franchisor or Franchisee to exercise any right under this Agreement, and no partial or single exercise of\nthat right, shall constitute a waiver of that or any other right pr", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_6'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_6", number: "6", title: "Clause 6", contract_id: "CONT_commercial_contract", category: "General", text: "This Agreement and the other Transaction Documents to which the parties hereto are parties constitute the sole and\nentire agreement of the parties to this Agreement with respect to the subject matter ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_7'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_7", number: "7", title: "Clause 7", contract_id: "CONT_commercial_contract", category: "General", text: "No amendment, modification or discharge of this Agreement, and no waiver hereunder, shall be valid or\nbinding unless set forth in writing and duly executed by the party against whom enforcement of the", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_8'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_8", number: "8", title: "Clause 8", contract_id: "CONT_commercial_contract", category: "General", text: "If any term or provision of this Agreement is invalid, illegal or unenforceable in any jurisdiction, such invalidity, illegality or\nunenforceability shall not affect any other term or provision of thi", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_9'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_9", number: "9", title: "Clause 9", contract_id: "CONT_commercial_contract", category: "General", text: "9.1 Pizza Fusion Marketing Fund\n9.1.1. We have the right, but not the obligation, to establish, maintain, and administer a fund for the marketing of the \u201cPizza\nFusion\u201d brand and Restaurants (the \u201cMark", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_10'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_10", number: "10", title: "Clause 10", contract_id: "CONT_commercial_contract", category: "General", text: "10.1. Computer System. We have the right to specify or require that certain brands, types, makes, and/or models of communications,\ncomputer systems, and hardware to be used by, between, or among Franc", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_11'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_11", number: "11", title: "Clause 11", contract_id: "CONT_commercial_contract", category: "General", text: "The words \u201chereof\u201d, \u201cherein\u201d and \u201chereunder\u201d and words of like import used in this Agreement shall refer to this\nAgreement as a whole and not to any particular provision of this Agreement. The caption", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_12'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_12", number: "12", title: "Clause 12", contract_id: "CONT_commercial_contract", category: "General", text: "During and after the term of this Agreement, you may not communicate, divulge, or use for any purpose other than the operation of the\nFranchised Business any confidential information, knowledge, trade", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_13'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_13", number: "13", title: "Clause 13", contract_id: "CONT_commercial_contract", category: "General", text: "We have the unrestricted right to transfer or assign all or any part of our rights and/or our obligations under this Agreement to any person\nor legal entity without your consent. You agree that we wil", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_14'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_14", number: "14", title: "Clause 14", contract_id: "CONT_commercial_contract", category: "General", text: "14.1. Definition of Transfer. In this Agreement, \u201cTransfer\u201d as a verb means to sell, assign, give away, pledge, or encumber, either\nvoluntarily or by operation of law (such as through divorce or bankr", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_15'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_15", number: "15", title: "Clause 15", contract_id: "CONT_commercial_contract", category: "General", text: "15.1. Termination By Us Without Notice. You will be in default under this Agreement and all rights granted by this Agreement will\nautomatically terminate without notice to you if you become insolvent ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_16'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_16", number: "16", title: "Clause 16", contract_id: "CONT_commercial_contract", category: "General", text: "16.1. Upon termination or expiration of this Agreement for any reason, unless we direct you otherwise:\n16.1.1. You agree to promptly pay all sums owing to us, our affiliates and suppliers, including, ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_17'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_17", number: "17", title: "Clause 17", contract_id: "CONT_commercial_contract", category: "General", text: "17.1. During Term. You acknowledge that this Agreement will give you access to valuable and confidential information regarding the\nSystem, including our business development strategy and the operation", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_18'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_18", number: "18", title: "Clause 18", contract_id: "CONT_commercial_contract", category: "General", text: "This Agreement does not create a fiduciary or other special relationship or make you or us an agent, legal representative, joint venturer,\npartner, employee, or servant of each other for any purpose. ", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_19'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_19", number: "19", title: "Clause 19", contract_id: "CONT_commercial_contract", category: "General", text: "You agree to hold harmless, defend, and indemnify us and our past, present and future affiliates, officers, directors, shareholders, agents,\nattorneys, consultants, and employees against any claims, l", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_20'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_20", number: "20", title: "Clause 20", contract_id: "CONT_commercial_contract", category: "General", text: "20.1. Consent. Whenever our prior written consent is required under this Agreement, you agree to make a timely written request to us for\nsuch consent. Our approval or consent must be in writing and si", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_21'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_21", number: "21", title: "Clause 21", contract_id: "CONT_commercial_contract", category: "General", text: "Notices related to this Agreement must be in writing and personally delivered, sent by registered mail, or by other means which affords the\nsender evidence of delivery, or of rejected delivery, to the", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_22'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_22", number: "22", title: "Clause 22", contract_id: "CONT_commercial_contract", category: "General", text: "This Agreement and the documents referred to herein constitute the entire agreement between you and us with respect to the Franchised\nBusiness and supersede all prior negotiations, representations, co", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_23'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_23", number: "23", title: "Clause 23", contract_id: "CONT_commercial_contract", category: "General", text: "23.1. Clauses are Severable. Each provision of this Agreement is severable from the others. If, for any reason, any provision is\ndetermined by a court to be invalid, the invalidity will not impair the", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_24'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_24", number: "24", title: "Clause 24", contract_id: "CONT_commercial_contract", category: "General", text: "This Agreement and the relationship between the parties is governed by and will be construed exclusively in accordance with the laws of\nthe State of Florida (without regard to, and without applying, F", label: "Clause"};
MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_25'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_25", number: "25", title: "Clause 25", contract_id: "CONT_commercial_contract", category: "General", text: "25.1. Submission to Mediation. Except as otherwise provided in Section 25.7 [Remedies Not Exclusive] below, any controversy or claim\narising between us will first be submitted to non-binding mediation", label: "Clause"};

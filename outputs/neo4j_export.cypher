MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_4.18'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_4.18", number: "4.18", title: "Clause 4.18", contract_id: "CONT_commercial_contract", category: "General", text: "Vendor shall immediately report to AT&T\u2019s representative any hazardous or\nunusual conditions or damage to any property caused or observed by Vendor or Vendor\u2019s agents on or\nabout the property where th", label: "Clause"};

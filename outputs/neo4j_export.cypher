MERGE (n:Clause {id: 'CLAUSE_CONT_commercial_contract_1.4'}) SET n += {clause_id: "CLAUSE_CONT_commercial_contract_1.4", number: "1.4", title: "Clause 1.4", contract_id: "CONT_commercial_contract", category: "General", text: "You agree not to engage in any of the sales activities that we have reserved to ourselves in Sections 1.3 [Our\nLimitations and Our Reserved Rights] above.\nPage 3 of 39\nSource: PF HOSPITALITY GROUP INC", label: "Clause"};
